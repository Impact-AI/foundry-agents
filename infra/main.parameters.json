		"recordsApiScope": { "value": "${RECORDS_API_SCOPE=}" },
		"developerAccess": { "value": "${DEVELOPER_ACCESS=false}" },
		"developerAccessSshKey": { "value": "${DEVELOPER_ACCESS_SSH_KEY=}" },
		"developerVmSize": { "value": "${DEVELOPER_VM_SIZE=Standard_D2as_v5}" },
		"agentEgress": { "value": "${AGENT_EGRESS=open}" },
		"privateTelemetry": { "value": "${PRIVATE_TELEMETRY=}" },
		"agentTracing": { "value": "${AGENT_TRACING=false}" },
		"policyAudit": { "value": "${POLICY_AUDIT=true}" },
		"backendImage": { "value": "${SERVICE_BACKEND_IMAGE_NAME=}" },
		"frontendImage": { "value": "${SERVICE_FRONTEND_IMAGE_NAME=}" },
		"backendExists": { "value": "${SERVICE_BACKEND_RESOURCE_EXISTS=false}" },
		"frontendExists": { "value": "${SERVICE_FRONTEND_RESOURCE_EXISTS=false}" },
		"servicesRunning": { "value": "${SERVICES_RUNNING=}" },
		"vaultHolds": { "value": "${KEY_VAULT_HOLDS=}" },
		"authSecret": { "value": "${AUTH_SECRET=}" },
