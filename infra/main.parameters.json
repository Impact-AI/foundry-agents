					"sku": "GlobalStandard",
					"capacity": 50
				},
				"smallChat": {
					"name": "small",
					"model": "gpt-5-mini",
					"version": "2025-08-07",
					"sku": "GlobalStandard",
					"capacity": 50
				},
				"embedding": {
					"name": "embedding",
					"model": "text-embedding-3-large",
					"version": "1",
					"sku": "Standard",
					"capacity": 50
				},
				"realtime": {
					"name": "realtime",
					"model": "gpt-realtime-2.1",
					"version": "2026-07-07",
					"sku": "GlobalStandard"
				},
				"knowledgeBase": {
					"name": "knowledge",
					"model": "gpt-5-mini",
					"version": "2025-08-07",
					"sku": "GlobalStandard"
				}
			}
		}
