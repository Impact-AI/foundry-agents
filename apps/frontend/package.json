{
	"name": "@app/frontend",
	"version": "0.0.0",
	"private": true,
	"description": "The chat client a person talks to: sign-in, the streamed turn, voice, the person's own settings and what the assistant remembers, the disclosure at every surface. No database, no Redis, no model call \u2014 every request goes to the backend through one server-side client.",
	"scripts": {
		"dev": "bun build server/main.ts --target=node --format=cjs --external next --outfile .next/dev-server.js && node .next/dev-server.js --dev",
		"build": "next build && bun run build:server",
		"build:server": "bun build server/main.ts --target=node --format=cjs --external next --outfile .next/standalone/apps/frontend/main.js",
		"start": "node .next/standalone/apps/frontend/main.js",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p e2e/tsconfig.json",
		"e2e:build": "bun run build && rm -rf .next/standalone/apps/frontend/.next/static .next/standalone/apps/frontend/public && cp -R .next/static .next/standalone/apps/frontend/.next/static && cp -R public .next/standalone/apps/frontend/public",
		"e2e": "playwright test --config e2e/playwright.config.ts"
	},
	"dependencies": {
		"@ag-ui/client": "1.0.2",
		"@copilotkit/react-core": "1.85.0",
		"@copilotkit/runtime": "1.85.0",
		"@platform/appearance": "workspace:*",
		"@platform/config": "workspace:*",
		"@platform/http": "workspace:*",
		"@platform/i18n": "workspace:*",
		"@platform/identity": "workspace:*",
		"@platform/metering": "workspace:*",
		"@platform/observability": "workspace:*",
		"@platform/prompt": "workspace:*",
		"next": "16.4.5",
		"next-auth": "^5.0.0-beta.32",
		"next-intl": "^4.13.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"rxjs": "7.8.1",
		"streamdown": "^2.7.1",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@platform/test-support": "workspace:*",
		"@axe-core/playwright": "4.14.0",
		"@playwright/test": "1.65.0",
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"typescript": "^5"
	}
}
