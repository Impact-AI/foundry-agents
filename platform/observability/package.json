{
	"name": "@platform/observability",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"description": "What a process may say about itself: OpenTelemetry for a Bun server and for Next, the scrub every span and log record passes before export, the probe filter, the live sampling ratio, and the two structured lines — a refusal and a model call — that reach the store as spans.",
