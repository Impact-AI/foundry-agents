param name string
param wafName string
param location string
param tags object
param workspaceId string
param environmentId string
param originHost string

var endpointName = 'frontend'

module waf 'br/public:avm/res/network/front-door-web-application-firewall-policy:0.3.3' = {
  name: 'waf'
  params: {
    name: wafName
    location: 'global'
    tags: tags
    sku: 'Premium_AzureFrontDoor'
    // Bodies are not inspected: prose in a chat body matches the SQL-injection
    // rules (942200 reads an ordinary sentence as one), and each route
    // validates and caps its own body. URI, query, headers and cookies still are.
    policySettings: { enabledState: 'Enabled', mode: 'Prevention', requestBodyCheck: 'Disabled' }
    managedRules: {
      managedRuleSets: [
        {
          ruleSetType: 'Microsoft_DefaultRuleSet'
          ruleSetVersion: '2.1'
          ruleSetAction: 'Block'
          exclusions: []
          // Every rule blocks: live voice is one WebSocket and sends no body
          // the content-type list (920420) would need relaxing for.
          ruleGroupOverrides: []
        }
        {
          ruleSetType: 'Microsoft_BotManagerRuleSet'
          ruleSetVersion: '1.0'
          ruleGroupOverrides: []
          exclusions: []
        }
      ]
    }
    // The module's default is a geo filter that blocks every address outside
    // the unknown-country code ZZ, which is every visitor.
    customRules: { rules: [] }
  }
}

// Premium, because only Premium reaches an origin over a private link: the
// environment's public ingress is closed and the link is the one way in.
// The link's connection is approved by the postprovision hook.
module profile 'br/public:avm/res/cdn/profile:0.20.0' = {
  name: 'front-door'
  params: {
    name: name
    location: 'global'
    tags: tags
    sku: 'Premium_AzureFrontDoor'
    originResponseTimeoutSeconds: 240
    originGroups: [
      {
        name: 'frontend'
        loadBalancingSettings: { sampleSize: 4, successfulSamplesRequired: 3 }
        healthProbeSettings: { probePath: '/health', probeProtocol: 'Https', probeRequestType: 'GET', probeIntervalInSeconds: 60 }
        origins: [
          {
            name: 'frontend'
            hostName: originHost
            originHostHeader: originHost
            httpsPort: 443
            enforceCertificateNameCheck: true
            sharedPrivateLinkResource: {
              privateLink: { id: environmentId }
              groupId: 'managedEnvironments'
              privateLinkLocation: location
              requestMessage: 'frontend'
            }
          }
        ]
      }
    ]
    afdEndpoints: [
      {
        name: endpointName
        // Azure's default, TenantReuse, maps the same endpoint name in the same
        // tenant to the same azurefd.net host, so a second deployment in a
        // tenant is refused at the end of its provision with "That resource
        // name isn't available". Per resource group, each deployment gets its own.
        autoGeneratedDomainNameLabelScope: 'ResourceGroupReuse'
        routes: [
          {
            name: 'all'
            originGroupName: 'frontend'
            patternsToMatch: ['/*']
            supportedProtocols: ['Http', 'Https']
            forwardingProtocol: 'HttpsOnly'
            httpsRedirect: 'Enabled'
            linkToDefaultDomain: 'Enabled'
          }
        ]
      }
    ]
    securityPolicies: [
      {
        name: 'waf'
        wafPolicyResourceId: waf.outputs.resourceId
        associations: [
          {
            domains: [{ id: resourceId('Microsoft.Cdn/profiles/afdEndpoints', name, endpointName) }]
            patternsToMatch: ['/*']
          }
        ]
      }
    ]
    diagnosticSettings: [{ workspaceResourceId: workspaceId }]
  }
}

output endpointHost string = profile.outputs.frontDoorEndpointHostNames[0]
