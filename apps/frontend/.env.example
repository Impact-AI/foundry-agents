# Bootstrap only: what names a resource, an endpoint or a secret, and what shapes
# one replica. Nothing here is a tunable, and nothing here is a fact the backend
# owns: the agent's id and every byte bound come from the backend's answers.

# --- process ---
IMAGE_TAG=                                 # the image's tag, reported as the service version

# --- backend (server-side only; the browser never calls it) ---
BACKEND_URL=http://localhost:4111

# --- authentication ---
# Signs the session cookie and every caller assertion this app's server mints
# for the backend. The backend must hold the same value.
AUTH_SECRET=

# How people sign in, decided once per deployment and read by both apps:
# `entra` is the identity provider; `local` is a demo sign-in with a name and
# no password, in which every sign-in is a new member account and none can be
# resumed. Who is premium is the registration's app roles, never a variable
# here.
AUTH_MODE=entra

# With AUTH_MODE=entra: Microsoft Entra ID, the sign-in provider.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# 1 refuses a sign-in whose token carries neither of the roles user, premium.
AUTH_REQUIRE_ROLE=

# Set by the template on a hardened deployment; AUTH_MODE=local, or
# AUTH_REQUIRE_ROLE off, then refuses to start.
HARDENED=

# Auth.js's own: the origin written into the sign-in redirect, which behind an
# edge is not the host the replica sees. The template sets it; a checkout run
# with `bun run dev` needs it only behind a proxy, and a production build run
# by hand needs it, since Auth.js trusts no host it was not told.
# AUTH_URL=

# --- http ---
SSE_HEARTBEAT_MS=15000                     # comment-frame cadence on relayed streams; 0 switches it off

# The server's keep-alive timeout for an idle connection, in milliseconds.
# Nothing sets it: unset, Node's own default stands. Raise it above the idle
# timeout of whatever proxy stands in front, if that proxy reuses connections.
# KEEP_ALIVE_TIMEOUT=

# --- observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=     # unset means no telemetry at all
