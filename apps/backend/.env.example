# Bootstrap only: what names a resource, a deployment, an identity, an endpoint
# or a secret, and what shapes one replica's process (a pool size, a timeout, a
# per-replica concurrency). Everything an operator tunes is a document in Azure
# App Configuration (`limits`, `llm`, `voice`, `agent`, `tools`, `guardrails`,
# `telemetry`, `edge`, `access`, `knowledge`); nothing here is a tunable.

# --- process ---
PORT=4111                                  # the port the server binds
IMAGE_TAG=                                 # the image's tag, reported as the service version outside a release
IMPACT_RELEASE_ID=                         # the release this image is (rel_ and 24 hex characters), on every span; a release workflow sets the three with the image
IMPACT_RELEASE_VERSION=                    # the release's version, reported as the service version while set
IMPACT_RELEASE_ENVIRONMENT=                # development or production, on every span as deployment.environment.name

# --- configuration store ---
APP_CONFIG_ENDPOINT=                       # https://<name>.azconfig.io; unset means compiled-in defaults
APP_CONFIG_KEY_PREFIX=                     # key prefix in the store (default app/)
APP_CONFIG_TIMEOUT_MS=                     # one read of the store (default 2000)
CONFIG_TTL_MS=                             # how long every stored document is served from memory (default 30000)

# --- authentication (access is the identity provider's app roles; no variable grants anything) ---
AUTH_SECRET=                               # signs every caller assertion; unset on a checkout (not deployed, NODE_ENV not production) opens the gate on one local account
AUTH_MODE=entra                            # entra (the identity provider) or local (a demo sign-in with a name; every sign-in is a new member account)
AUTH_REQUIRE_ROLE=                         # 1 refuses a sign-in whose token carries neither of the roles user, premium
HARDENED=                                  # the template sets it on a hardened deployment; AUTH_MODE=local, or AUTH_REQUIRE_ROLE off, then refuses to start
PRIVATE_NETWORKING=                        # the template sets it when the services sit behind private endpoints; the agent document's memory.store then defaults to own, and foundry is refused

# --- components chosen at deploy time (the starting value of a settings field; the document, once stored, is the operator's) ---
MEMORY_STORE=                              # foundry or own; unset: foundry, own with PRIVATE_NETWORKING
HISTORY_STORE=                             # own or foundry; unset: own
RETRIEVAL_ENGINE=                          # hybrid or knowledgeBase; unset: hybrid
VOICE_ENGINE=                              # speechToSpeech or cascade; unset: speechToSpeech

# --- cosmos db (keyless; the identity holds Cosmos DB Built-in Data Contributor on the database) ---
COSMOS_ENDPOINT=                           # https://<account>.documents.azure.com:443/: the accounts, the persona's versions and the thread index
COSMOS_DATABASE=app                        # the database on it (default app)

# --- redis (never required once up: every module names its fallback; a configured Redis that never answers refuses the start) ---
REDIS_URL=                                 # rediss://<objectId>@<host>:10000 dials with an Entra token; a URL with a password is used as given; unset runs without the fleet-shared layer
REDIS_COMMAND_TIMEOUT_MS=
REDIS_CONNECT_TIMEOUT_MS=
REDIS_RETRY_COOLDOWN_MS=

# --- foundry agent service (keyless; the identity holds Foundry User on the project) ---
FOUNDRY_PROJECT_ENDPOINT=                  # https://<account>.services.ai.azure.com/api/projects/<project>: agent versions, conversations, the memory store, skills
FOUNDRY_RAI_POLICY=                        # the guardrail every agent version carries (rai_config); unset carries none
FOUNDRY_MEMORY_STORE=                      # the memory store (preview) the job makes and turns read when the agent document's memory.store is foundry (default person-memory)
FOUNDRY_REQUEST_DEADLINE_MS=               # one request to the project, or a streamed response's headers (default 30000)

# --- azure openai (the account and the deployments, the only place a deployment is named) ---
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_SMALL_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=         # its vector width, which the search index is built at (default 3072)
AZURE_OPENAI_EMBEDDING_MODEL=              # the model behind that deployment, which AI Search's skillset and vectorizer name beside it
AZURE_OPENAI_REALTIME_DEPLOYMENT=          # the realtime deployment a speech-to-speech voice agent runs on; unset, every session runs the cascade
AZURE_OPENAI_REALTIME_MODEL=               # the model behind it, which decides whether a session's update carries a reasoning effort
AZURE_OPENAI_REALTIME_ALTERNATE_DEPLOYMENT=  # optional: a second realtime deployment a voice tester may switch their own sessions to
AZURE_OPENAI_REALTIME_ALTERNATE_MODEL=       # the model behind it; the alternate is offered only with this set
AZURE_OPENAI_KNOWLEDGE_BASE_DEPLOYMENT=      # the knowledge base's planning deployment; unset, the base holds no model and every search runs at minimal
AZURE_OPENAI_KNOWLEDGE_BASE_MODEL=           # the model behind it, which the knowledge base names beside the deployment

# --- knowledge (azure ai search; what a search returns is the `knowledge` document) ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=                        # the one index (default chunks)
KNOWLEDGE_PLANNER_DEADLINE_MS=             # one query plan, model call included (default 8000)
KNOWLEDGE_PLANNER_INFLIGHT=                # plans in flight on this replica; over it the plain search runs (default 6)

# --- storage (keyless; the backend holds Storage Blob Data Reader, the job Contributor) ---
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ENDPOINT=                    # overrides the origin for an emulator
AZURE_STORAGE_CONTAINER=library            # every library, each under its name (default library)
AZURE_STORAGE_APPEARANCE_CONTAINER=appearance  # the deployment's logo, apart from the library (default appearance)
AZURE_STORAGE_RESOURCE_ID=                 # the job only: the account's resource id, which AI Search's data source connects with

# --- records (the business system the record tools and the stage's cards read; docs/worked-example.md) ---
RECORDS_API_URL=                           # the system's base URL; unset: the sample's own records, in memory
RECORDS_API_SCOPE=                         # the .default scope the backend's identity calls it with; unset sends no token (a stand-in on this machine)

# --- agent (how a turn runs and how memory is written and read are the `agent` document) ---
MEMORY_CACHE_TTL_SECONDS=                  # what is remembered, cached across the fleet (default 60)
PERSON_CACHE_TTL_SECONDS=
LAST_CONVERSATION_CACHE_TTL_SECONDS=
THREAD_OWNER_CACHE_TTL_SECONDS=
TURN_CLAIM_TTL_SECONDS=
TURN_CLAIM_DEADLINE_MS=
WARMUP_TTL_MS=
TITLE_MAX_INFLIGHT=
TITLE_DEADLINE_MS=

# --- metering ---
METERING_SWEEP_INTERVAL_MS=
METERING_UNAVAILABLE_LOG_SECONDS=

# --- http ---
SSE_HEARTBEAT_MS=15000                     # 0 switches the keep-alive comment frame off

# --- observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=     # unset means no telemetry
IMPACT_ENDPOINT=                           # impact.ai's OTLP traces URL for the product; with IMPACT_API_KEY every span is also copied there
IMPACT_API_KEY=                            # the product's ingest key (deployed, a Key Vault reference); unset, or the vault's placeholder, copies nothing
PROBLEM_LOG=                               # 0 switches the refusal line off
LLM_USAGE_LOG=                             # 0 switches the model-call line off

# --- development only: a deployed replica refuses to start with any of these set ---
COSMOS_KEY=                                # the emulator's key, with COSMOS_ENDPOINT=http://localhost:8081
