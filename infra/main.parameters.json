		"searchReplicas": { "value": "${SEARCH_REPLICAS=1}" },
		"backendMinReplicas": { "value": "${BACKEND_MIN_REPLICAS=1}" },
		"frontendMinReplicas": { "value": "${FRONTEND_MIN_REPLICAS=1}" },
		"seedSampleLibrary": { "value": "${SEED_SAMPLE_LIBRARY=true}" },
